{
  "services": [
    {
      "name": "indra",
      "command": [
        "/workspace/scratch/b641098e5d96/indra-venv/bin/python",
        "/workspace/scratch/b641098e5d96/ocr-benchmark-assets/backend/server.py"
      ],
      "env": {
        "OMP_THREAD_LIMIT": "1",
        "OMP_NUM_THREADS": "1",
        "OPENBLAS_NUM_THREADS": "1",
        "MKL_NUM_THREADS": "1",
        "NUMEXPR_NUM_THREADS": "1",
        "INDRA_MODEL_DIR": "/workspace/scratch/b641098e5d96/indra-models",
        "INDRA_HOST": "127.0.0.1",
        "INDRA_PORT": "19081",
        "INDRA_WORKERS": "2",
        "INDRA_THREADS": "1",
        "INDRA_RECOGNITION_BATCH": "64",
        "INDRA_BATCH_METRICS": "1",
        "INDRA_MATH": "0",
        "INDRA_QUEUE_CAPACITY": "2",
        "INDRA_QUEUE_TIMEOUT_SECONDS": "30",
        "INDRA_REQUEST_TIMEOUT_SECONDS": "120"
      },
      "readiness_url": "http://127.0.0.1:19081/readyz"
    },
    {
      "name": "tika",
      "command": [
        "/usr/lib/jvm/java-17-openjdk-amd64/bin/java",
        "-Xms64m",
        "-Xmx256m",
        "-XX:ActiveProcessorCount=2",
        "-XX:+UseSerialGC",
        "-Djava.awt.headless=true",
        "-jar",
        "/workspace/scratch/b641098e5d96/tika-server-standard-3.3.2.jar",
        "-c",
        "/workspace/scratch/b641098e5d96/ocr-plan-tika-stock-2/tika-indra.xml"
      ],
      "env": {
        "OMP_THREAD_LIMIT": "1",
        "OMP_NUM_THREADS": "1",
        "OPENBLAS_NUM_THREADS": "1",
        "MKL_NUM_THREADS": "1",
        "NUMEXPR_NUM_THREADS": "1",
        "INDRA_ADDR": "127.0.0.1:19081"
      },
      "readiness_url": "http://127.0.0.1:19098/version"
    }
  ]
}
