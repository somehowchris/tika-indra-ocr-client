<?xml version="1.0" encoding="UTF-8"?>
<properties>
  <server>
    <host>127.0.0.1</host>
    <port>9999</port>
    <noFork>false</noFork>
    <javaPath>/usr/bin/java</javaPath>
    <taskTimeoutMillis>300000</taskTimeoutMillis>
    <minimumTimeoutMillis>30000</minimumTimeoutMillis>
    <taskPulseMillis>1000</taskPulseMillis>
    <maxForkedStartupMillis>120000</maxForkedStartupMillis>
    <maxFiles>10000</maxFiles>
    <forkedJvmArgs>
      <arg>-Xms64m</arg>
      <arg>-Xmx512m</arg>
      <arg>-XX:ActiveProcessorCount=1</arg>
      <arg>-XX:+UseSerialGC</arg>
      <arg>-Djava.awt.headless=true</arg>
      <arg>-Djava.io.tmpdir=/tmp</arg>
    </forkedJvmArgs>
    <endpoints>
      <endpoint>tika</endpoint>
      <endpoint>rmeta</endpoint>
      <endpoint>version</endpoint>
      <endpoint>mime</endpoint>
    </endpoints>
  </server>
  <parsers>
    <parser class="org.apache.tika.parser.DefaultParser">
      <parser-exclude class="org.apache.tika.parser.pdf.PDFParser"/>
      <parser-exclude class="org.apache.tika.parser.ocr.TesseractOCRParser"/>
    </parser>
    <parser class="org.apache.tika.parser.pdf.PDFParser">
      <params>
        <param name="ocrStrategy" type="string">ocr_only</param>
        <param name="ocrStrategyAuto" type="string">better</param>
        <param name="ocrRenderingStrategy" type="string">all</param>
        <param name="ocrDPI" type="int">300</param>
        <param name="ocrImageType" type="string">gray</param>
        <param name="ocrImageFormatName" type="string">png</param>
        <param name="extractInlineImages" type="bool">false</param>
        <param name="catchIntermediateExceptions" type="bool">false</param>
      </params>
    </parser>
    <parser class="org.apache.tika.parser.ocr.TesseractOCRParser">
      <params>
        <param name="tesseractPath" type="string">/opt/indra/</param>
        <param name="preloadLangs" type="bool">false</param>
        <param name="language" type="string"></param>
        <param name="pageSegMode" type="string">3</param>
        <param name="outputType" type="string">txt</param>
        <param name="timeout" type="int">60</param>
        <param name="enableImagePreprocessing" type="bool">false</param>
        <param name="applyRotation" type="bool">false</param>
        <param name="preserveInterwordSpacing" type="bool">false</param>
      </params>
    </parser>
  </parsers>
</properties>
